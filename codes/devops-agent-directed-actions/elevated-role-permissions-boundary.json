{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CeilingEc2AndSupportingReads",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "sts:DecodeAuthorizationMessage",
        "tag:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CeilingTaggedWafAndIdentityContainment",
      "Effect": "Allow",
      "Action": [
        "wafv2:*",
        "iam:GetUser",
        "iam:ListAccessKeys",
        "iam:ListUserPolicies",
        "iam:ListAttachedUserPolicies",
        "iam:UpdateAccessKey",
        "iam:PutUserPolicy",
        "iam:DeleteUserPolicy",
        "iam:AttachUserPolicy",
        "iam:DetachUserPolicy"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "devops-agent-directed-actions-test"
        }
      }
    },
    {
      "Sid": "CeilingTestBucketOnly",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::devops-agent-da-test-target-781863586106",
        "arn:aws:s3:::devops-agent-da-test-target-781863586106/*"
      ]
    },
    {
      "Sid": "CeilingPassRoleForTestInstanceProfileOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::781863586106:role/devops-agent-da-test-InstanceRole-O3b4b4MmmDiQ"
    },
    {
      "Sid": "DenyMutationsOnUntaggedExistingResources",
      "Effect": "Deny",
      "NotAction": [
        "ec2:Describe*",
        "ec2:Get*",
        "ec2:Search*",
        "ec2:CreateTags",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:ec2:*:*:security-group/*",
        "arn:aws:ec2:*:*:network-interface/*",
        "arn:aws:ec2:*:*:network-acl/*",
        "arn:aws:ec2:*:*:subnet/*",
        "arn:aws:ec2:*:*:route-table/*",
        "arn:aws:ec2:*:*:vpc/*",
        "arn:aws:ec2:*:*:internet-gateway/*",
        "arn:aws:ec2:*:*:natgateway/*",
        "arn:aws:ec2:*:*:elastic-ip/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Project": "devops-agent-directed-actions-test"
        }
      }
    },
    {
      "Sid": "DenySnapshotOfUntaggedVolumes",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateSnapshot",
        "ec2:CreateSnapshots"
      ],
      "Resource": "arn:aws:ec2:*:*:volume/*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Project": "devops-agent-directed-actions-test"
        }
      }
    },
    {
      "Sid": "DenySecurityGroupCreationOutsideTheTestVpc",
      "Effect": "Deny",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:*:*:security-group/*",
      "Condition": {
        "Null": {
          "ec2:Vpc": "false"
        },
        "StringNotEquals": {
          "ec2:Vpc": "arn:aws:ec2:ap-northeast-1:781863586106:vpc/vpc-02eefa43a8538275d"
        }
      }
    },
    {
      "Sid": "DenyInstanceLaunchOutsideTheTestSubnets",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:subnet/*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Project": "devops-agent-directed-actions-test"
        }
      }
    }
  ]
}
